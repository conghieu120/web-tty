AUTH_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string
# Cookie lifetime in seconds. 0 = session cookie (cleared when browser closes). Default 7 days.
COOKIE_MAX_AGE=604800
# Idle auth/terminal timeout (Go duration). Default 30m.
IDLE_TIMEOUT=30m
# Artificial login delay (Go duration). Default 3s.
LOGIN_DELAY=3s
# Max concurrent PTY terminals (one per browser tab). Default 5.
MAX_TERMINALS=5
LISTEN_ADDR=:8080
# Comma-separated Vite origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
